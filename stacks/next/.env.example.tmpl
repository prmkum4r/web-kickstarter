# Copy to .env.local (init does this for you). Read only through src/platform/env.ts.
#
# Everything prefixed NEXT_PUBLIC_ is inlined into the browser bundle — never put secrets here.

NEXT_PUBLIC_APP_NAME={{PROJECT_TITLE}}

# API base URL. /mock serves the JSON fixtures in public/mock until a real backend exists.
NEXT_PUBLIC_API_URL=/mock

# --- e2e (Playwright) ---
E2E_BASE_URL=http://localhost:3000
